  <DataSets>
    <DataSet Name="ThreeYearSalesDataset">
      <Query>
        <DataSourceName>ThreeYearSalesDataset</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FinancialYear">
            <Value>=Parameters!FinancialYear.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FinancialMonth">
            <Value>=Parameters!FinancialMonth.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@SelectionType">
            <Value>=Parameters!SelectionType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>EXEC dbo.usp_GetThreeYearSalesComparison
 
   @FinancialYear = @FinancialYear,
    
   @FinancialMonth = @FinancialMonth,
    
   @SelectionType = @SelectionType;</CommandText>
      </Query>
      <Fields>
